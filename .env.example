# Copy to .env and fill in. .env is never committed.

# The database password: letters and digits only. Keep it: the database is
# created with it, and changing it here later locks the app out.
POSTGRES_PASSWORD=change-me

# Where the app is served: http://localhost:8000. WEB_BIND=0.0.0.0 opens it
# to the shop's network (no login: only on a network you trust).
WEB_PORT=8000
WEB_BIND=127.0.0.1

# The database, from this computer only (for a database app).
DB_PORT=5433

# Backups: when (cron: minute hour day month weekday) and how many to keep.
# Every Sunday at 02:00, the last 8 weeks. The app warns when the newest
# backup is older than BACKUP_WARN_DAYS.
BACKUP_SCHEDULE=0 2 * * 0
BACKUP_KEEP=8
BACKUP_WARN_DAYS=8
# A Mac asleep or off at the scheduled time misses it; an hourly check then
# takes the backup once the newest is this many days old.
BACKUP_MAX_AGE_DAYS=7

# A second place every backup is copied to, off this disk if you can: an
# external drive or a synced folder (iCloud Drive, Google Drive), e.g.
#   BACKUP_COPY_DIR=/Users/you/Library/Mobile Documents/com~apple~CloudDocs/Konveksi backups
# The folder must exist. Leave empty for no copy.
BACKUP_COPY_DIR=

# Only if the shop's computers reach this one by a name that isn't an IP
# address or a .local name: list it here (comma-separated), e.g. the app's
# Tailscale address, konveksi.<tailnet>.ts.net (see the README).
ALLOWED_HOSTS=

# The app's own address on your tailnet (README, "On a phone"): set
# COMPOSE_PROFILES=tailscale to run the Tailscale container. It signs in
# with TS_AUTHKEY (from the Tailscale admin console, Settings → Keys), or,
# left empty, with the link in `docker compose logs tailscale`.
# TS_HOSTNAME is the device name, and so the address.
COMPOSE_PROFILES=
TS_AUTHKEY=
TS_HOSTNAME=konveksi
TZ=Asia/Jakarta

# Photo reading (optional). A Claude API key, or a local Ollama model.
ANTHROPIC_API_KEY=
OLLAMA_VISION_MODEL=
